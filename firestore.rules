rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'guilhermealisson14@hotmail.com'
        && request.auth.token.email_verified == true;
    }

    match /profiles/{userId} {
      allow read: if ownsUser(userId);
      allow create: if ownsUser(userId)
        && request.resource.data.user_id == userId;
      allow update: if ownsUser(userId)
        && request.resource.data.user_id == userId
        && request.resource.data.consent_version == resource.data.consent_version
        && request.resource.data.consent_at == resource.data.consent_at;
      allow delete: if ownsUser(userId);
    }

    match /mastery/{userId}/concepts/{conceptId} {
      allow read: if ownsUser(userId) || isAdmin();
      allow create, update: if ownsUser(userId)
        && request.resource.data.user_id == userId;
      allow delete: if ownsUser(userId);
    }

    match /sessions/{userId}/items/{sessionId} {
      allow read: if ownsUser(userId);
      allow create: if ownsUser(userId)
        && request.resource.data.user_id == userId;
      allow update, delete: if ownsUser(userId);
    }

    match /support/{userId}/tickets/{ticketId} {
      allow read: if ownsUser(userId);
      allow create: if ownsUser(userId)
        && request.resource.data.user_id == userId
        && request.resource.data.status == 'open'
        && request.resource.data.category in ['bug', 'account', 'progress', 'suggestion', 'other']
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 3
        && request.resource.data.subject.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 15
        && request.resource.data.description.size() <= 2000
        && request.resource.data.created_at is string
        && request.resource.data.created_at.size() <= 40;
      allow update, delete: if false;
    }

    match /{path=**}/tickets/{ticketId} {
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['response', 'status', 'answered_at']);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
