rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /profiles/{userId} {
      allow read: if ownsUser(userId);
      allow create, update: if ownsUser(userId)
        && request.resource.data.user_id == userId;
      allow delete: if false;
    }

    match /mastery/{userId}/concepts/{conceptId} {
      allow read: if ownsUser(userId);
      allow create, update: if ownsUser(userId)
        && request.resource.data.user_id == userId;
      allow delete: if false;
    }

    match /sessions/{userId}/items/{sessionId} {
      allow read: if ownsUser(userId);
      allow create: if ownsUser(userId)
        && request.resource.data.user_id == userId;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
